# Copia este archivo como ".env" y rellénalo.

# ===== TELEGRAM (https://my.telegram.org -> API development tools) =====
TG_API_ID=1234567
TG_API_HASH=pon_aqui_tu_api_hash
TG_PHONE=+34600000000
# IDs de los grupos/canales a escuchar, separados por coma (python main.py --listar-chats)
TG_CHATS=-1001234567890
NOTIFY=true

# ===== IA =====
# gemini  -> GRATIS. Clave en https://aistudio.google.com/apikey  (recomendado)
# groq    -> GRATIS. Clave en https://console.groq.com/keys
# ollama  -> GRATIS y sin internet, corre en tu PC (más lento). No necesita clave.
# anthropic -> de pago (Claude)
AI_PROVIDER=gemini
AI_API_KEY=pega_aqui_tu_clave
# Vacío = modelo recomendado (gemini-flash-latest / llama-3.3-70b-versatile / qwen2.5:7b)
AI_MODEL=
# Por debajo de esta confianza no ejecuta y te avisa
MIN_CONFIDENCE=0.7

# ===== METATRADER 5 (déjalo vacío para usar la cuenta abierta en el terminal) =====
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# ===== RIESGO =====
# true = solo simula (empieza SIEMPRE así). false = opera de verdad.
DRY_RUN=true
RISK_PERCENT=0.5
# Lote total máximo por señal (0 = sin límite)
MAX_LOT=1.0
# Lote fijo según el capital: 0.01 = 0,01 lotes por cada 100 EUR de balance (0 = usar RISK_PERCENT)
LOT_PER_100=0
MAX_OPEN_SIGNALS=3
DAILY_LOSS_LIMIT_PERCENT=3
# parciales = 1 operación que cierra una parte en cada TP | dividir = 1 posición por TP | primero = solo TP1
TP_MODE=parciales
MAX_TPS=5
# true = mueve a breakeven en cuanto se toca el TP1. false = solo cuando el grupo lo diga ("MOVER EL SL A BE")
MOVE_BE_ON_TP1=false
BE_OFFSET_POINTS=0
# SL por defecto en puntos si la señal no trae SL (0 = no operar esas señales)
DEFAULT_SL_POINTS=0
# Si el precio se ha ido más de esto (en puntos) de la entrada, pone una orden limit en vez de entrar a mercado
ENTRY_TOLERANCE_POINTS=100
MAX_SPREAD_POINTS=0
DEVIATION_POINTS=50
PENDING_EXPIRY_MINUTES=240
MAX_MESSAGE_AGE_SEC=120
MAGIC=770077

# ===== INFORME SEMANAL (llega a tus "Mensajes guardados"; escribe /informe allí para pedirlo cuando quieras) =====
# Día: 1=lunes ... 6=sábado, 7=domingo (0 = no enviarlo). Hora del PC.
REPORT_WEEKDAY=6
REPORT_HOUR=10
REPORT_DAYS=7

# ===== SÍMBOLOS =====
# Cómo llama el grupo a cada activo = cómo se llama en TU bróker
SYMBOL_MAP=GOLD=XAUUSD,ORO=XAUUSD,XAU=XAUUSD,NAS100=NDX100,US100=NDX100,NASDAQ=NDX100,USTEC=NDX100
# Sufijo del bróker si lo tiene (p.ej. .r, .pro, m)
SYMBOL_SUFFIX=
# Solo se operan estos (vacío = todos)
ALLOWED_SYMBOLS=XAUUSD,NDX100
# Tamaño de 1 pip, para señales que dan SL/TP en pips
PIP_SIZES=XAUUSD=0.1,NDX100=1
